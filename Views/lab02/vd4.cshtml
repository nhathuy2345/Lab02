@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Tạo thanh Navigator</title>
    <style type="text/css">
        a:link,a:visited{
            background-color:#808080;
            text-decoration:none;
           text-align:center;
           position:relative;
           display:block;
           width:100px;
           border: 2px solid black;
           border-color: #def #567 #123 #cde;
           padding:5px;
           margin: 10px auto;
        }
        a:link {
            color: whitesmoke;
        }
        a:visited{
            color:darkred;

        }
        a:hover{
            background-color:#FF7000;
            top: 5px;
            left:5px
        }
    </style>
</head>
<body>
    <div id=" menu">
        <a href="#">Home</a>
        <a href="#">About</a>
        <a href="#">History</a>
        <a href="#">Team</a>
        <a href="#">Office</a>

    </div>
</body>
</html>
