@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Định dạng danh sách</title>
</head>
<body>
    <p>Đây là định dạng inside</p>
    <ul style="list-style-type:lower-alpha; list-style-position:inside;">
        <li>item 1</li>
        <li>item 2</li>
        <li>item 3</li>

    </ul>
    <p>Đây là list dạng outside</p>
    <ul style="list-style-type:lower-alpha; list-style-position:outside;">
        <li>item 1</li>
        <li>item 2</li>
        <li>item 3</li>

    </ul>
    <p>Đây là đoạn list không chia bullet</p>
    <ul style="list-style-type:none;">
        <li>item 1</li>
        <li>item 2</li>
        <li>item 3</li>
    </ul>
    <p>Đây là list sử dụng ảnh để làm bullet</p>
    <ul style="list-style-image:url('../Content/images/icon xe.jpg'); list-style-position:inside;">
        <li>item 1</li>
        <li>item 2</li>
        <li>item 3</li>

    </ul>
</body>
</html>
