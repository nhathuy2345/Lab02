                </h2>

                <p class="contact-info">
                    <strong>Phone:</strong> (07) 853 6060
                </p>

                <p class="contact-info">
                    <strong>Fax:</strong> (07) 853 6060
                </p>

                <p class="contact-info">
                    <strong>Email:</strong>
                    <span class="orange">
                        info@enlighten.co.nz
                    </span>
                </p>

                <p class="contact-info">
                    <strong>P.O Box:</strong>
                    14159, Hamilton, New Zealand
                </p>

                <a href="#" class="more-info">
                    More contact information...
                </a>

            </div>


            <div id="sidebar">

                <h2>
                    FEATURED PROJECTS
                </h2>


                <div class="project-item">

                    <h4>
                        The New Zealand National Party
                    </h4>

                    <p>
